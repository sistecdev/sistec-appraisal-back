# ── Required ────────────────────────────────────────────────
# Its own database. On MongoDB Atlas this can be a new database name in the
# same cluster as MILE (…mongodb.net/sistec_appraisal?…) — not MILE's database.
MONGO_URI=mongodb://127.0.0.1:27017/sistec_appraisal
# A long random string. Never reuse MILE's.
JWT_SECRET=change-me-to-a-long-random-string
# Where the website runs (used in email links and CORS). Comma-separate several.
CLIENT_URL=http://localhost:5174

# ── Optional ────────────────────────────────────────────────
PORT=5100
JWT_EXPIRES_IN=7d
INSTITUTE_NAME=Sagar Institute of Science & Technology (SISTec), Bhopal
INSTITUTE_SHORT=SISTec

# Creating the Super Admin from the website (/setup). Only works while the
# database has no accounts at all. The Super Admin then makes the HR accounts.
SETUP_KEY=choose-a-one-time-setup-key

# Email (account invites, password reset, appraisal updates). Leave SMTP_HOST
# empty to switch email off — HR then hands out temporary passwords.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SISTec Appraisal <no-reply@sistec.ac.in>
# For testing only: "json" writes emails to the log instead of sending them.
MAIL_TRANSPORT=
